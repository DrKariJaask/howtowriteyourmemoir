---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy";
const description =
  "Learn how HowToWriteYourMemoir.com handles personal information and protects your privacy.";
---

<BaseLayout title={title} description={description}>
  <article>
    <p><a href="/">← Back to home</a></p>

    <h1>Privacy Policy</h1>

    <p>
      Your privacy is important to us.
    </p>

    <p>
      HowToWriteYourMemoir.com is designed primarily as an educational website.
      We collect as little personal information as possible.
    </p>

    <h2>Information We Collect</h2>

    <p>
      We do not require visitors to create an account or provide personal
      information simply to browse the website.
    </p>

    <p>
      If you contact us by email, we will receive the information you choose to
      include in your message.
    </p>

    <h2>Cookies</h2>

    <p>
      The website may use essential technical cookies required for normal
      operation.
    </p>

    <p>
      If analytics or additional services are introduced in the future, this
      Privacy Policy will be updated accordingly.
    </p>

    <h2>Third-Party Services</h2>

    <p>
      Links on this website may lead to third-party websites, including Amazon.
      Those services have their own privacy policies and practices.
    </p>

    <h2>Your Rights</h2>

    <p>
      Depending on your location, you may have rights regarding your personal
      information under applicable privacy laws, including the GDPR.
    </p>

    <h2>Contact</h2>

    <p>
      If you have questions about this Privacy Policy, please visit our
      <a href="/contact/">Contact page</a>.
    </p>
  </article>
</BaseLayout>
